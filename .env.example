# Copy this file to .env.local (gitignored) and fill in real values.
# main.py loads .env then .env.local (overriding) at startup -- see its
# own docstring for why this only happens on `python main.py`, not on import.

# --- Optional: LLM provider for @planner (llm.py) ----------------------------
# Unset -> defaults to a local Ollama model ("ollama:qwen2.5:7b"), so a
# fresh checkout never has to send hardware specs/candidate configs to a
# cloud API. Requires `ollama serve` running with that model pulled
# (`ollama pull qwen2.5:7b`). Set to any other "<provider>:<model>" string
# langchain.chat_models.init_chat_model() accepts to opt into a cloud
# provider instead -- see README.md's "실행" section for verified models.
# TESSELLATE_PLANNER_MODEL=anthropic:claude-sonnet-4-5-20250929

# Matching provider API key -- only needed if TESSELLATE_PLANNER_MODEL above is
# set to a cloud provider.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
GOOGLE_API_KEY=

# --- Optional: LLM call operations (llm.py) ----------------------------------
# TESSELLATE_LLM_MAX_RETRIES=3
# TESSELLATE_LLM_BASE_DELAY_SECONDS=1.0
# TESSELLATE_LLM_MAX_DELAY_SECONDS=20.0
# TESSELLATE_LLM_COST_PER_1K_INPUT_USD=
# TESSELLATE_LLM_COST_PER_1K_OUTPUT_USD=
# TESSELLATE_LLM_MAX_TOTAL_COST_USD=
# TESSELLATE_LLM_MAX_TOTAL_TOKENS=

# --- Optional: QAT dataset scope / device (tools/qat.py) ---------------------
# TESSELLATE_QAT_TRAIN_SIZE=512
# TESSELLATE_QAT_VAL_SIZE=128
# TESSELLATE_QAT_TEST_SIZE=1000
# TESSELLATE_QAT_BATCH_SIZE=32
# TESSELLATE_QAT_SEED=0
# TESSELLATE_QAT_DEVICE=

# --- Optional: structured logging (observability.py) -------------------------
# TESSELLATE_LOG_DIR=
