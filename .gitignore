# Runtime artifacts: checkpoint DBs, downloaded CIFAR10/pretrained weights,
# observability.py's structured logs -- all regenerated locally, never
# something to commit (the CIFAR10 cache alone is ~340MB).
.cache/
scratch_qat_test/
# observability.py's default AUTOCIM_LOG_DIR and any ad-hoc log output.
logs/
*.log
*.jsonl
# tools/dashboard.py's --dashboard-out target, if written into the repo root
# -- README.md's own examples name it both ways, so cover both.
dashboard*.html
report*.html
# --dashboard-out targets written under reports/ (any name) -- one machine's
# measured session, regenerated by re-running main.py, not a source file.
reports/*.html
# tools/run_ablation.py / tools/optuna_compare.py / tools/repeat_search.py
# --out targets: one machine's measured run, regenerated by re-running the
# tool, not a source file. Real findings worth keeping belong summarized in
# README.md's "실측으로 확인한 것" section, not as a raw dump in git.
*_results.json

# Secrets / local config -- provider API keys (ANTHROPIC_API_KEY etc.) and
# any per-machine override belong in the environment or an untracked .env,
# never committed. .env.example is the exception: no real values, just
# documents which variables main.py's dotenv loading understands.
.env
.env.*
!.env.example
*.pem
*.key

# Model/data artifacts -- pretrained weights and datasets belong in .cache/
# (already ignored above) or an external store, never in git history.
*.pt
*.pth
*.ckpt
*.safetensors

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/
.ipynb_checkpoints/

# Editor/IDE
.vscode/
.idea/

# Local-only Local tool settings (permissions/tool config specific to one
# machine) -- a shared .config/settings.json, if one is ever added, stays
# tracked.
.config/settings.local.json
.config/settings.json

# OS junk
.DS_Store
Thumbs.db
# 시연 산출물 -- 노트북 실행 시 재생성됨
notebooks/demo_dashboard.html

# LangGraph checkpoint DBs under runs/ are the raw resume state, not a
# record anyone reads: the 2026-08-22 capture alone is 217MB, past
# GitHub's 100MB per-file limit, and it would bloat the repo forever.
# The run README says where the local copy lives; the terminal log,
# events.jsonl and the generated report are what is actually kept.
runs/**/checkpoints.sqlite
